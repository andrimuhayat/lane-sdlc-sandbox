{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(npm test *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./risk-tiers.yml)",
      "Edit(./.mcp.json)",
      "Edit(./.claude/**)",
      "Edit(./.github/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.claude/**)",
      "Edit(~/.codex/**)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh api *)",
      "Bash(gh auth *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin main *)",
      "Bash(git push origin master *)",
      "Edit(./.githooks/**)",
      "Bash(git push --no-verify *)",
      "Bash(git push * --no-verify*)",
      "Bash(git -c *)",
      "Bash(git config *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "gh"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "api.anthropic.com"
      ]
    }
  }
}
